<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
    <l:layout title="${it.displayName}">
        <l:main-panel>
            <link rel="stylesheet" href="${rootURL}/plugin/jenkins-gretl-datenportal-plugin/css/gretl-datenportal.css" />
            <script src="${rootURL}/plugin/jenkins-gretl-datenportal-plugin/js/gretl-datenportal.js"></script>

            <j:set var="overview" value="${it.runOverview}" />
            <j:set var="scanResult" value="${overview.scanResult}" />

            <div class="gdp-page">
                <div class="gdp-page-header">
                    <div>
                        <h1>${it.displayName}</h1>
                        <div class="gdp-header-actions gdp-header-actions--below-title">
                            <a class="jenkins-button jenkins-button--primary" href="${rootURL}/${it.urlName}/jobs">Jobs starten</a>
                        </div>
                    </div>
                </div>

                <j:if test="${scanResult.hasMessages()}">
                    <section class="gdp-panel">
                        <div class="gdp-panel__header">
                            <h2>Hinweise</h2>
                        </div>
                        <table class="pane gdp-table">
                            <thead>
                                <tr>
                                    <th>Typ</th>
                                    <th>Meldung</th>
                                    <th>Pfad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <j:forEach var="message" items="${scanResult.messages}">
                                    <tr>
                                        <td><span class="gdp-badge gdp-badge--warning">${message.severity}</span></td>
                                        <td>${message.message}</td>
                                        <td class="gdp-muted">${message.path}</td>
                                    </tr>
                                </j:forEach>
                            </tbody>
                        </table>
                    </section>
                </j:if>

                <section class="gdp-run-overview">
                    <form class="gdp-toolbar" method="get" action="${rootURL}/${it.urlName}/" data-gdp-run-filters="true">
                        <label class="gdp-filter">
                            <span>Organisation</span>
                            <select class="gdp-control gdp-select" name="organization">
                                <option value="">Alle</option>
                                <j:forEach var="option" items="${overview.organizationOptions}">
                                    <j:choose>
                                        <j:when test="${option.selected}"><option value="${option.value}" selected="selected">${option.label}</option></j:when>
                                        <j:otherwise><option value="${option.value}">${option.label}</option></j:otherwise>
                                    </j:choose>
                                </j:forEach>
                            </select>
                        </label>
                        <label class="gdp-filter">
                            <span>Datensatz</span>
                            <select class="gdp-control gdp-select" name="dataset">
                                <option value="">Alle</option>
                                <j:forEach var="option" items="${overview.datasetOptions}">
                                    <j:choose>
                                        <j:when test="${option.selected}"><option value="${option.value}" selected="selected">${option.label}</option></j:when>
                                        <j:otherwise><option value="${option.value}">${option.label}</option></j:otherwise>
                                    </j:choose>
                                </j:forEach>
                            </select>
                        </label>
                        <label class="gdp-filter">
                            <span>Status</span>
                            <select class="gdp-control gdp-select" name="status">
                                <option value="">Alle</option>
                                <j:forEach var="option" items="${overview.statusOptions}">
                                    <j:choose>
                                        <j:when test="${option.selected}"><option value="${option.value}" selected="selected">${option.label}</option></j:when>
                                        <j:otherwise><option value="${option.value}">${option.label}</option></j:otherwise>
                                    </j:choose>
                                </j:forEach>
                            </select>
                        </label>
                        <noscript><button class="jenkins-button" type="submit">Filtern</button></noscript>
                    </form>

                    <j:choose>
                        <j:when test="${!overview.hasExecutedRuns()}">
                            <div class="gdp-empty-state">
                                <h3>Noch keine Jobs ausgeführt.</h3>
                                <p>Sobald ein Datenportal-Job gestartet wurde, erscheint er hier.</p>
                            </div>
                        </j:when>
                        <j:when test="${overview.runs.isEmpty()}">
                            <div class="gdp-empty-state gdp-empty-state--filtered">
                                <h3>Keine passenden Ausführungen gefunden.</h3>
                                <p><a href="${rootURL}/${it.urlName}/">Filter zurücksetzen</a>, um die neuesten ausgeführten Jobs zu sehen.</p>
                            </div>
                        </j:when>
                        <j:otherwise>
                            <div class="gdp-run-list">
                                <j:forEach var="run" items="${overview.runs}">
                                    <article class="gdp-run-row"
                                             data-gdp-organization="${run.organizationValue}"
                                             data-gdp-dataset="${run.datasetValue}"
                                             data-gdp-status="${run.status}">
                                        <div class="gdp-run-row__status">
                                            <span class="gdp-badge" data-gdp-status="${run.status}">${run.statusLabel}</span>
                                        </div>
                                        <div class="gdp-run-row__main">
                                            <div class="gdp-run-row__title">
                                                <span>${run.displayTitle}</span>
                                            </div>
                                        </div>
                                        <div class="gdp-run-row__end">
                                            <div class="gdp-run-row__time">
                                                <span>${run.startTime}</span>
                                            </div>
                                            <div class="gdp-run-row__actions">
                                                <a class="jenkins-button" href="${rootURL}/${it.urlName}/run?job=${run.jobNameEncoded}&amp;build=${run.buildNumber}">Details</a>
                                            </div>
                                        </div>
                                    </article>
                                </j:forEach>
                            </div>
                            <nav class="gdp-pagination" aria-label="Ausführungen blättern">
                                <span class="gdp-muted">${overview.firstResult}–${overview.lastResult} von ${overview.totalCount}</span>
                                <div class="gdp-pagination__links">
                                    <j:choose>
                                        <j:when test="${overview.hasPreviousPage()}">
                                            <a class="jenkins-button" rel="prev" href="${rootURL}/${it.urlName}/${overview.previousPageQuery}">Zurück</a>
                                        </j:when>
                                        <j:otherwise><button class="jenkins-button" type="button" disabled="disabled">Zurück</button></j:otherwise>
                                    </j:choose>
                                    <span class="gdp-muted">Seite ${overview.page} von ${overview.pageCount}</span>
                                    <j:choose>
                                        <j:when test="${overview.hasNextPage()}">
                                            <a class="jenkins-button" rel="next" href="${rootURL}/${it.urlName}/${overview.nextPageQuery}">Weiter</a>
                                        </j:when>
                                        <j:otherwise><button class="jenkins-button" type="button" disabled="disabled">Weiter</button></j:otherwise>
                                    </j:choose>
                                </div>
                            </nav>
                        </j:otherwise>
                    </j:choose>
                </section>
            </div>
        </l:main-panel>
    </l:layout>
</j:jelly>
